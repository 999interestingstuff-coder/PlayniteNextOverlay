<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:av="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:local="clr-namespace:PlayniteGameOverlay"
        xmlns:sys="clr-namespace:System.Windows;assembly=PresentationFramework"
        mc:Ignorable="d av"
        d:DataContext="{d:DesignInstance Type=local:OverlayWindowViewModel, IsDesignTimeCreatable=True}"
        x:Class="PlayniteGameOverlay.OverlayWindow"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="NoResize"
        WindowState="Maximized"
        ShowInTaskbar="False" 
        av:DesignHeight="900" 
        av:DesignWidth="1600" 
        Width="1600">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- ===== Achievement list styles ===== -->
        <Style x:Key="AchHintBadge" TargetType="Border">
            <Setter Property="Background" Value="#FF3A3A3A"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,1,6,1"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="AchHintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FFD0D0D0"/>
        </Style>

        <!-- Filter tabs: Tag is bound to "is this the active filter" -->
        <Style x:Key="AchTabButton" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#FFB0B0B0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TabBorder" Background="#FF262626" CornerRadius="8" Padding="16,7,16,7"
                                BorderBrush="#40808080" BorderThickness="1">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#FF333333"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#FFE8E8E8"/>
                                <Setter Property="Foreground" Value="#FF141414"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AchActionButton" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActBorder" Background="#FF2A2A2A" CornerRadius="8" Padding="12,7,14,7"
                                BorderBrush="#40808080" BorderThickness="1">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActBorder" Property="Background" Value="#FF3A3A3A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ActBorder" Property="Background" Value="#FF4A4A4A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AchListItemStyle" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="12,10,14,10"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" Background="#FF242424" CornerRadius="8" BorderThickness="2"
                                BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#FF2C2C2C"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#FF363636"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#C0FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Audio panel styles ===== -->
        <Style x:Key="AudioRowCard" TargetType="Border">
            <Setter Property="Background" Value="#FF242424"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="#30808080"/>
            <Setter Property="Padding" Value="18,12,18,12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="Background" Value="#FF363636"/>
                    <Setter Property="BorderBrush" Value="#C0FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AudioRowButton" TargetType="Button">
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RowBorder" Background="#FF242424" CornerRadius="10" BorderThickness="2"
                                BorderBrush="#30808080" Padding="18,12,18,12">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="#FF2C2C2C"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="#FF363636"/>
                                <Setter TargetName="RowBorder" Property="BorderBrush" Value="#C0FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AudioSliderRepeat" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent">
                            <Border Height="6" CornerRadius="3" VerticalAlignment="Center" Background="{TemplateBinding Background}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AudioSliderThumb" TargetType="Thumb">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Ellipse Width="20" Height="20" Fill="White" Stroke="#FF1B1B1B" StrokeThickness="2"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AudioSlider" TargetType="Slider">
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="SmallChange" Value="2"/>
            <Setter Property="LargeChange" Value="10"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="28" Background="Transparent">
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource AudioSliderRepeat}" Background="#FFE0B040"
                                                  Command="{x:Static Slider.DecreaseLarge}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource AudioSliderRepeat}" Background="#FF3A3A3A"
                                                  Command="{x:Static Slider.IncreaseLarge}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource AudioSliderThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small caption above a group of rows -->
        <Style x:Key="AudioSectionCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FF9A9A9A"/>
            <Setter Property="Margin" Value="4,14,0,8"/>
        </Style>
    </Window.Resources>

    <Viewbox Stretch="Uniform">
        <!-- Set a container with fixed aspect ratio -->
        <Grid x:Name="OverlayRoot" Width="1600" Height="900">
            <!-- Main overlay layer (0.4.5.3: wrapped so it can be disabled = not focusable while the achievement list is open;
                 children intentionally not re-indented to keep the diff small) -->
            <Grid x:Name="MainLayer" IsEnabled="{Binding IsMainLayerEnabled}">
            <!-- Semi-transparent full-screen background -->
            <Rectangle Fill="#CC000000" Width="Auto" Height="Auto" />

            <!-- Left side buttons container -->
            <Border Background="#FF242424" CornerRadius="10" Padding="20" 
                Width="300" Height="Auto" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="38,120,0,0" BorderBrush="#80808080" BorderThickness="1,1,1,1">
                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Width="260">
                    <!-- Windows 11 style buttons with icons -->
                    <Button x:Name="ReturnToGameButton" Height="70" Width="260" 
                        Foreground="White" FontSize="20" FontWeight="SemiBold"
                        BorderThickness="0" Padding="20,10" Margin="0,0,0,20"
                        Command="{Binding ReturnToGameCommand}">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <Path Data="M10,17V14H3V10H10V7L15,12L10,17M10,2H19A2,2 0 0,1 21,4V20A2,2 0 0,1 19,22H10A2,2 0 0,1 8,20V18H10V20H19V4H10V6H8V4A2,2 0 0,1 10,2Z" 
                                      Fill="White" Width="24" Height="24" Stretch="Uniform" Margin="-3,0,18,0"/>
                                <TextBlock Text="Return to Game" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button.Content>
                        <Button.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FF363636"/>
                                    </Trigger>
                                    <Trigger Property="IsFocused" Value="True">
                                        <Setter Property="Background" Value="#FF363636"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button x:Name="ShowPlayniteButton" Height="70" Width="260" 
                        Foreground="White" FontSize="20" FontWeight="SemiBold"
                        BorderThickness="0" Padding="20,10" Margin="0,0,0,20"
                        Command="{Binding ShowPlayniteCommand}">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <Path Data="M 53.760 28.496 C 33.560 33.609, 22.270 49.113, 11.485 86.552 C -1.871 132.917, -3.512 171.688, 7.418 182.618 C 16.377 191.577, 28.929 186.235, 46.444 166.008 C 62.325 147.668, 61.688 147.872, 105 147.265 C 154.990 146.565, 161.600 147.871, 172.538 160.607 C 189.871 180.789, 199.516 187.766, 208.662 186.735 C 216.030 185.904, 219.883 181.093, 222.732 169.164 C 224.636 161.195, 225.526 144.474, 224.201 141.570 C 223.682 140.432, 222.519 134.006, 221.617 127.291 C 219.719 113.165, 213.465 87.415, 208.356 72.695 C 199.166 46.216, 187.888 33.071, 170.465 28.533 C 161.863 26.292, 157.859 26.596, 142.413 30.662 C 129.121 34.161, 127.763 34.325, 112 34.345 C 96.501 34.365, 94.772 34.170, 83.500 31.129 C 69.024 27.224, 61.441 26.552, 53.760 28.496 M 157 61.709 C 149.546 64.450, 149.583 75.265, 157.055 77.869 C 164.461 80.451, 171.088 72.939, 167.509 66.018 C 165.420 61.978, 161.094 60.204, 157 61.709 M 37.840 74.887 C 21.794 85.062, 29.010 110, 48 110 C 59.143 110, 67 102.143, 67 91 C 67 79.736, 59.157 72, 47.736 72 C 43.562 72, 41.394 72.632, 37.840 74.887 M 132.923 84.923 C 128.823 89.023, 128.883 93.882, 133.077 97.411 C 136.757 100.507, 140.807 100.727, 144.253 98.016 C 149.230 94.101, 148.515 86.352, 142.909 83.453 C 138.733 81.293, 136.177 81.670, 132.923 84.923 M 174.923 84.923 C 172.928 86.918, 172 88.848, 172 91 C 172 94.937, 176.712 100, 180.376 100 C 189.075 100, 193.099 90.945, 187.077 84.923 C 183.147 80.993, 178.853 80.993, 174.923 84.923 M 153.923 105.923 C 148.967 110.879, 150.248 117.952, 156.580 120.598 C 159.544 121.836, 160.456 121.836, 163.420 120.598 C 169.752 117.952, 171.033 110.879, 166.077 105.923 C 162.147 101.993, 157.853 101.993, 153.923 105.923 M 0.370 153 C 0.370 158.775, 0.535 161.137, 0.737 158.250 C 0.939 155.363, 0.939 150.637, 0.737 147.750 C 0.535 144.863, 0.370 147.225, 0.370 153" 
                                      Fill="White" Width="28" Height="24" Stretch="Uniform" Margin="-2,0,15,0"/>
                                <TextBlock Text="Show Playnite" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button.Content>
                        <Button.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FF363636"/>
                                    </Trigger>
                                    <Trigger Property="IsFocused" Value="True">
                                        <Setter Property="Background" Value="#FF363636"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button x:Name="AudioButton" Height="70" Width="260" 
                        Foreground="White" FontSize="20" FontWeight="SemiBold"
                        BorderThickness="0" Padding="20,10" Margin="0,0,0,20"
                        Visibility="{Binding HasAudioSwitcher, Converter={StaticResource BoolToVis}}"
                        Command="{Binding OpenAudioPanelCommand}">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <Path Data="M14,3.23V5.29C16.89,6.15 19,8.83 19,12C19,15.17 16.89,17.84 14,18.7V20.77C18,19.86 21,16.28 21,12C21,7.72 18,4.14 14,3.23M16.5,12C16.5,10.23 15.5,8.71 14,7.97V16C15.5,15.29 16.5,13.76 16.5,12M3,9V15H7L12,20V4L7,9H3Z" 
                                      Fill="White" Width="24" Height="24" Stretch="Uniform" Margin="-3,0,18,0"/>
                                <TextBlock Text="Audio" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button.Content>
                        <Button.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FF363636"/>
                                    </Trigger>
                                    <Trigger Property="IsFocused" Value="True">
                                        <Setter Property="Background" Value="#FF363636"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button x:Name="CloseGameButton" Height="70" Width="260" 
                        Foreground="White" FontSize="20" FontWeight="SemiBold"
                        BorderThickness="0" Padding="20,10"
                        Command="{Binding CloseGameCommand}">
                        <Button.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                        <Button.Style>
                            <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FF363636"/>
                                    </Trigger>
                                    <Trigger Property="IsFocused" Value="True">
                                        <Setter Property="Background" Value="#FF363636"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z" 
                                Fill="White" Width="20" Height="20" Stretch="Uniform" Margin="2,0,17,0"/>
                            <TextBlock Text="Exit Game" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Content container -->
            <TextBlock x:Name="GameTitle" Text="{Binding GameTitle}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Left" 
                           Margin="36,4,0,0" Height="56" VerticalAlignment="Top" FontSize="36" Width="1309"/>
            <Border x:Name="OuterImgBorder" 
        BorderBrush="#80808080" 
        BorderThickness="1,1,1,1" 
        Width="{Binding CoverWidth}" 
        Height="{Binding CoverHeight}" 
        Margin="0,120,36,0" 
        HorizontalAlignment="Right" 
        VerticalAlignment="Top" 
        CornerRadius="8,8,8,8" 
        Background="#80808080">
                <Border x:Name="InnerImgBorder" 
            BorderBrush="#80808080" 
            BorderThickness="0,0,0,0" 
            HorizontalAlignment="Left" 
            VerticalAlignment="Top" 
            CornerRadius="7,7,7,7" 
            Margin="1,1,1,1">
                    <Border.Clip>
                        <RectangleGeometry RadiusX="7" RadiusY="7" x:Name="ImgBorderClip">
                            <RectangleGeometry.Rect>
                                <Binding Path="InnerRect" />
                            </RectangleGeometry.Rect>
                        </RectangleGeometry>
                    </Border.Clip>
                    <Image x:Name="GameCoverImage" 
               Source="{Binding CoverImagePath}"
               Stretch="UniformToFill" 
               VerticalAlignment="Center" 
               HorizontalAlignment="Center"/>
                </Border>
            </Border>
            <!-- Clock -->
            <TextBlock x:Name="Clock" Text="{Binding CurrentTime}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Right" 
                       Margin="0,5,36,0" VerticalAlignment="Top" FontSize="24" Width="74" TextAlignment="Right" />

            <Grid x:Name="Battery" Visibility="{Binding HasBattery, Converter={StaticResource BoolToVis}}">
                <Rectangle x:Name="BatteryBar" HorizontalAlignment="Left" Height="17" Margin="1437,13,0,0" Fill="#FF48AF30" VerticalAlignment="Top" Width="{Binding BatteryBarWidth}"/>
                <Rectangle HorizontalAlignment="Right" Height="17" Margin="0,13,121,0" Fill="White" VerticalAlignment="Top" Width="5"/>
                <Rectangle Stroke="White" Margin="0,9,124,0" StrokeThickness="4" Width="43" HorizontalAlignment="Right" VerticalAlignment="Top" Height="25"/>
                <TextBlock x:Name="BatteryText" Text="{Binding BatteryPercentage, StringFormat={}{0}%}" HorizontalAlignment="Left" Margin="1436,13,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontWeight="Bold" Foreground="White" Width="37" TextAlignment="Center" Height="16"/>
            </Grid>
            <TextBlock x:Name="ProcessInfo_DEBUG" Text="{Binding DebugInfo}" Visibility="{Binding DebugVisible, Converter={StaticResource BoolToVis}}" HorizontalAlignment="Left" Margin="355,124,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Height="286" Width="821" Foreground="White" RenderTransformOrigin="0.526,0.47"/>
            <Border x:Name="SessionPanel" Background="#FF242424" CornerRadius="10" 
                    Width="375" Height="56" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,677,36,0" BorderBrush="#80808080" BorderThickness="1,1,1,1" Padding="18,8,18,4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Vertical Divider -->
                    <Rectangle Grid.Column="1" Grid.Row="0" Width="1" Margin="24,2,24,-11" Fill="#80808080" VerticalAlignment="Stretch"/>

                    <!-- Total Play Time (Column 0) -->
                    <StackPanel Grid.Column="0" Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <Path Fill="#FFD0D0D0" 
                              Width="16" 
                              Height="16"
                              Data="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0M8 3.5a.5.5 0 0 0-1 0V9a.5.5 0 0 0 .252.434l3.5 2a.5.5 0 0 0 .496-.868L8 8.71z" Margin="0,0,8,0"/>
                        <TextBlock x:Name="PlayTime" Text="{Binding TotalPlaytimeText}" TextWrapping="Wrap" Foreground="#FFFFFFFF" FontSize="20" FontWeight="Bold"/>
                    </StackPanel>

                    <!-- Session Play Time (Column 2) -->
                    <StackPanel Grid.Column="2" Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <Path Fill="#FFD0D0D0" 
                              Width="16" 
                              Height="16"
                              Data="M6.5 0a.5.5 0 0 0 0 1H7v1.07A7.001 7.001 0 0 0 8 16a7 7 0 0 0 5.29-11.584l.013-.012.354-.354.353.354a.5.5 0 1 0 .707-.707l-1.414-1.415a.5.5 0 1 0-.707.707l.354.354-.354.354-.012.012A6.97 6.97 0 0 0 9 2.071V1h.5a.5.5 0 0 0 0-1zm2 5.6V9a.5.5 0 0 1-.5.5H4.5a.5.5 0 0 1 0-1h3V5.6a.5.5 0 1 1 1 0" Margin="0,0,8,0"/>
                        <TextBlock x:Name="SessionTime" Text="{Binding SessionPlaytimeText}" TextWrapping="Wrap" Foreground="#FFFFFFFF" FontSize="20" FontWeight="Bold"/>
                    </StackPanel>

                    <!-- Caption Labels - Left Aligned -->
                    <TextBlock Grid.Column="0" Grid.Row="1" Text="ALL TIME" FontSize="9" Foreground="#80808080" HorizontalAlignment="Left" Margin="24,2,0,0"/>
                    <TextBlock Grid.Column="2" Grid.Row="1" Text="THIS SESSION" FontSize="9" Foreground="#80808080" HorizontalAlignment="Left" Margin="24,2,0,0"/>
                </Grid>
            </Border>

            <!-- Solaris profile (avatar, background, username, title), under the Playtime panel. Shown only while the game was
                 started through the Solaris fullscreen theme and Solaris is the active theme; follows Solaris > Theme Options. -->
            <Grid x:Name="SolarisProfileCard" Width="375" Height="112" VerticalAlignment="Top" HorizontalAlignment="Right"
                  Margin="0,749,36,0" IsHitTestVisible="False" Focusable="False"
                  Visibility="{Binding SolarisProfile.IsVisible, Converter={StaticResource BoolToVis}}">
                <Border Background="#FF242424" CornerRadius="10" BorderBrush="#80808080" BorderThickness="1,1,1,1"/>

                <!-- Profile background: fades in from the left, like in Solaris -->
                <Border Width="373" Height="110" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border.Clip>
                        <RectangleGeometry Rect="0,0,373,110" RadiusX="9" RadiusY="9"/>
                    </Border.Clip>
                    <Image Source="{Binding SolarisProfile.Background}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image.OpacityMask>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00000000" Offset="0"/>
                                <GradientStop Color="#E6000000" Offset="0.85"/>
                            </LinearGradientBrush>
                        </Image.OpacityMask>
                    </Image>
                </Border>

                <Grid Margin="18,0,18,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Avatar -->
                    <Grid Grid.Column="0" Width="76" Height="76" VerticalAlignment="Center">
                        <Ellipse Width="76" Height="76" Fill="#1AFFFFFF"/>
                        <Image Source="{Binding SolarisProfile.Avatar}" Width="72" Height="72" Stretch="UniformToFill"
                               HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="Fant">
                            <Image.Clip>
                                <EllipseGeometry Center="36,36" RadiusX="36" RadiusY="36"/>
                            </Image.Clip>
                        </Image>
                    </Grid>

                    <!-- Username and profile title -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                        <TextBlock Text="{Binding SolarisProfile.UserName}" Foreground="White" FontSize="24" FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis" MaxWidth="245" HorizontalAlignment="Left"
                                   Visibility="{Binding SolarisProfile.ShowUserName, Converter={StaticResource BoolToVis}}"/>
                        <Border Background="#66808080" CornerRadius="5" Padding="7,1,7,2" Margin="0,3,0,0" HorizontalAlignment="Left"
                                Visibility="{Binding SolarisProfile.ShowTitle, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding SolarisProfile.Title}" Foreground="#FFE8E8E8" FontSize="13"
                                       TextTrimming="CharacterEllipsis" MaxWidth="230"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Achievement Panel with visibility binding -->
            <Border x:Name="AchFade1" Background="#FF121212" CornerRadius="9" Padding="20,16,20,16" 
                    Width="352" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="52,608,0,0" 
                    BorderBrush="#30808080" BorderThickness="1,1,1,1"
                    Height="{Binding ActualHeight, ElementName=AchievementPanel}"
                    Visibility="{Binding HasAchievements, Converter={StaticResource BoolToVis}}"/>
            <Border x:Name="AchFade2" Background="#FF1B1B1B" CornerRadius="9.5" Padding="20,16,20,16" 
                    Width="365" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="46,604,0,0" 
                    BorderBrush="#40808080" BorderThickness="1,1,1,1"
                    Height="{Binding ActualHeight, ElementName=AchievementPanel}"
                    Visibility="{Binding HasAchievements, Converter={StaticResource BoolToVis}}"/>
            <!-- 0.4.5.3: the panel is a Button so it is clickable (mouse/touchpad), takes part in the controller/keyboard
                 focus navigation like the other overlay buttons and is activated with A / Enter / Space. -->
            <Button x:Name="AchievementPanel"
                    Width="377" MinHeight="104" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="40,600,0,0"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" ClipToBounds="False"
                    UseLayoutRounding="True" SnapsToDevicePixels="True"
                    Visibility="{Binding HasAchievements, Converter={StaticResource BoolToVis}}"
                    Command="{Binding OpenAchievementListCommand}" Cursor="Hand" FocusVisualStyle="{x:Null}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PanelBorder" Background="#FF242424" CornerRadius="10" Padding="20,16,20,16"
                                BorderBrush="#80808080" BorderThickness="1,1,1,1" ClipToBounds="False">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PanelBorder" Property="Background" Value="#FF363636"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="PanelBorder" Property="Background" Value="#FF363636"/>
                                <Setter TargetName="PanelBorder" Property="BorderBrush" Value="#D0FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Achievement Icon -->
                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="4" Background="#80808080" Margin="0,6,15,0" VerticalAlignment="Top">
                        <Border.Clip>
                            <RectangleGeometry RadiusX="4" RadiusY="4" Rect="0,0,32,32"/>
                        </Border.Clip>
                        <Image x:Name="LastAchievementIcon" Stretch="UniformToFill" Width="32" Height="32" Source="{Binding LastAchievementIcon}"/>
                    </Border>

                    <!-- Achievement Info -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" ClipToBounds="False">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Path Fill="#D0808080" Height="11" Width="12" Stretch="Uniform" Data="M0 0.75c0-0.414 0.336-0.75 0.75-0.75h2.885c0.019 0 0.037 0.001 0.056 0.002h6.621c0.018-0.001 0.036-0.002 0.054-0.002H13.25c0.414 0 0.75 0.336 0.75 0.75V3.635c0 1.859-1.396 3.392-3.197 3.609-0.447 1.369-1.614 2.413-3.053 2.686V12.5h2.615c0.414 0 0.75 0.336 0.75 0.75s-0.336 0.75-0.75 0.75H7.026c-0.009 0-0.017 0-0.026 0s-0.017 0-0.026 0H3.635c-0.414 0-0.75-0.336-0.75-0.75s0.336-0.75 0.75-0.75H6.25V9.93c-1.439-0.273-2.605-1.317-3.053-2.686C1.396 7.027 0 5.494 0 3.635V0.75ZM2.885 5.634V1.5H1.5v2.135c0 0.915 0.576 1.696 1.385 1.999ZM11.115 1.5v4.134c0.809-0.304 1.385-1.084 1.385-1.999V1.5h-1.385Z" Margin="0,0,5,-1"/>
                            <TextBlock x:Name="LastAchievementLabel" Text="RECENT ACHIEVEMENT" FontSize="11" Foreground="#80808080"/>
                            <TextBlock Text="&#8226;" FontSize="11" Foreground="#60808080" Margin="4,0,4,0"/>
                            <TextBlock x:Name="LastAchievementDate" Text="{Binding LastAchievementTimeText}" FontSize="11" Foreground="#80808080"/>
                        </StackPanel>

                        <TextBlock x:Name="LastAchievementName" Text="{Binding LastAchievement.Name}" 
                                   Foreground="White" FontWeight="Bold" FontSize="16" TextTrimming="CharacterEllipsis"/>

                        <TextBlock x:Name="LastAchievementDescription" Text="{Binding LastAchievement.Description}" 
                                   Foreground="#FFD0D0D0" FontSize="12" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                   MaxHeight="34" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- "View all" hint -->
                    <TextBlock Grid.Column="1" Text="VIEW ALL &#x203A;" FontSize="11" FontWeight="Bold" Foreground="#A0A0A0A0"
                               HorizontalAlignment="Right" VerticalAlignment="Top"/>
                </Grid>
            </Button>

            <TextBlock x:Name="UnlockPercent" Text="{Binding UnlockPercentText}" 
                       Visibility="{Binding HasAchievements, Converter={StaticResource BoolToVis}}" 
                       HorizontalAlignment="Left" Margin="60,575,0,0" TextWrapping="Wrap" 
                       VerticalAlignment="Top" Foreground="White" FontWeight="Bold"/>

            <!-- Shortcut Buttons -->
            <Border Focusable="False" Background="#FF242424" CornerRadius="10" x:Name="ShortcutBar"
                    MinWidth="64" MinHeight="64" VerticalAlignment="Bottom" HorizontalAlignment="Left" 
                    BorderBrush="#80808080" BorderThickness="1,1,1,1" Padding="4,4,4,4" Margin="40,0,0,20" Visibility="{Binding ShowShortcutButtons, Converter={StaticResource BoolToVis}}">
                <ItemsControl Focusable="False" ItemsSource="{Binding ShortcutButtons}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Width="60" Height="60" Margin="4" 
                                    Command="{Binding DataContext.ShortcutButtonCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    >
                                <Button.Resources>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent"/>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="Transparent"/>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>
                                </Button.Resources>
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Opacity" Value="0.7" />
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="border"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="#FF363636"/>
                                                            <Setter Property="Opacity" Value="1"/>
                                                        </Trigger>
                                                        <Trigger Property="IsFocused" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="#FF363636"/>
                                                            <Setter Property="Opacity" Value="1"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="{Binding Title}" TextAlignment="Center" 
               TextWrapping="Wrap" FontSize="10" Foreground="White" Margin="-75,-40,-75,0" 
               FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsFocused, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Image Grid.Row="1" Source="{Binding IconPath}" Width="32" Height="32" Margin="0,4,0,4"/>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
            </Grid>
            <!-- end of MainLayer -->

            <!-- ===== Achievement list layer (0.4.5.3): in-overlay view, same window, shown on top of MainLayer ===== -->
            <Grid x:Name="AchievementListLayer" Visibility="{Binding IsAchievementListOpen, Converter={StaticResource BoolToVis}}">
                <Rectangle Fill="#D0000000"/>
                <Border Width="1180" Height="830" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="#FF1B1B1B" CornerRadius="12" BorderBrush="#80808080" BorderThickness="1" Padding="32,24,32,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header: game name + X/Y unlocked + percent -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Path Fill="#FFE0B040" Height="13" Width="14" Stretch="Uniform" VerticalAlignment="Center"
                                          Data="M0 0.75c0-0.414 0.336-0.75 0.75-0.75h2.885c0.019 0 0.037 0.001 0.056 0.002h6.621c0.018-0.001 0.036-0.002 0.054-0.002H13.25c0.414 0 0.75 0.336 0.75 0.75V3.635c0 1.859-1.396 3.392-3.197 3.609-0.447 1.369-1.614 2.413-3.053 2.686V12.5h2.615c0.414 0 0.750 0.336 0.75 0.75s-0.336 0.75-0.75 0.75H7.026c-0.009 0-0.017 0-0.026 0s-0.017 0-0.026 0H3.635c-0.414 0-0.75-0.336-0.75-0.75s0.336-0.75 0.75-0.75H6.25V9.93c-1.439-0.273-2.605-1.317-3.053-2.686C1.396 7.027 0 5.494 0 3.635V0.75ZM2.885 5.634V1.5H1.5v2.135c0 0.915 0.576 1.696 1.385 1.999ZM11.115 1.5v4.134c0.809-0.304 1.385-1.084 1.385-1.999V1.5h-1.385Z"/>
                                    <TextBlock Text="ACHIEVEMENTS" FontSize="13" FontWeight="Bold" Foreground="#FF9A9A9A" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding AchievementList.GameName}" FontSize="32" FontWeight="Bold" Foreground="White"
                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0,0,0">
                                <TextBlock Text="{Binding AchievementList.PercentText}" FontSize="36" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding AchievementList.SummaryText}" FontSize="15" Foreground="#FFD0D0D0" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>

                        <!-- Progress bar -->
                        <ProgressBar Grid.Row="1" Height="6" Margin="0,14,0,16" Minimum="0" Maximum="100"
                                     Value="{Binding AchievementList.Percent, Mode=OneWay}"
                                     Foreground="#FFE0B040" Background="#FF333333" BorderThickness="0"/>

                        <!-- Filter tabs + actions -->
                        <Grid Grid.Row="2" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Border Style="{StaticResource AchHintBadge}">
                                    <TextBlock Text="LB" Style="{StaticResource AchHintText}"/>
                                </Border>
                                <Button x:Name="AchTabAll" Style="{StaticResource AchTabButton}" Content="{Binding AchievementList.AllTabText}"
                                        Tag="{Binding AchievementList.IsFilterAll}" Command="{Binding AchievementList.SetFilterCommand}" CommandParameter="All"/>
                                <Button x:Name="AchTabUnlocked" Style="{StaticResource AchTabButton}" Content="{Binding AchievementList.UnlockedTabText}"
                                        Tag="{Binding AchievementList.IsFilterUnlocked}" Command="{Binding AchievementList.SetFilterCommand}" CommandParameter="Unlocked"/>
                                <Button x:Name="AchTabLocked" Style="{StaticResource AchTabButton}" Content="{Binding AchievementList.LockedTabText}"
                                        Tag="{Binding AchievementList.IsFilterLocked}" Command="{Binding AchievementList.SetFilterCommand}" CommandParameter="Locked"/>
                                <Border Style="{StaticResource AchHintBadge}">
                                    <TextBlock Text="RB" Style="{StaticResource AchHintText}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding AchievementList.ShowingText}" FontSize="13" Foreground="#FF808080"
                                       VerticalAlignment="Center" Margin="12,0,12,0"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Style="{StaticResource AchActionButton}" Command="{Binding AchievementList.ToggleRevealHiddenCommand}"
                                        Visibility="{Binding AchievementList.HasHiddenLocked, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Style="{StaticResource AchHintBadge}">
                                            <TextBlock Text="Y" Style="{StaticResource AchHintText}"/>
                                        </Border>
                                        <TextBlock Text="{Binding AchievementList.RevealHiddenText}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource AchActionButton}" Command="{Binding CloseAchievementListCommand}" Margin="10,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Style="{StaticResource AchHintBadge}">
                                            <TextBlock Text="B" Style="{StaticResource AchHintText}"/>
                                        </Border>
                                        <TextBlock Text="Back" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- The list: virtualized, recycled containers, icons loaded lazily per realized row -->
                        <Grid Grid.Row="3">
                            <ListBox x:Name="AchievementListBox"
                                     ItemsSource="{Binding AchievementList.Items}"
                                     ItemContainerStyle="{StaticResource AchListItemStyle}"
                                     Background="Transparent" BorderThickness="0" Padding="0,0,4,0"
                                     SelectionMode="Single" FocusVisualStyle="{x:Null}"
                                     KeyboardNavigation.DirectionalNavigation="None"
                                     KeyboardNavigation.TabNavigation="None"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.CanContentScroll="True"
                                     ScrollViewer.PanningMode="VerticalOnly"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     VirtualizingPanel.ScrollUnit="Pixel"
                                     VirtualizingPanel.CacheLengthUnit="Item"
                                     VirtualizingPanel.CacheLength="3,3">
                                <ListBox.Resources>
                                    <!-- slim dark scrollbar (drag the thumb with mouse/touchpad) -->
                                    <Style TargetType="ScrollBar">
                                        <Setter Property="Width" Value="8"/>
                                        <Setter Property="MinWidth" Value="8"/>
                                        <Setter Property="Margin" Value="6,0,0,0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ScrollBar">
                                                    <Border Background="#20FFFFFF" CornerRadius="4">
                                                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                                                            <Track.Thumb>
                                                                <Thumb>
                                                                    <Thumb.Template>
                                                                        <ControlTemplate TargetType="Thumb">
                                                                            <Border Background="#90FFFFFF" CornerRadius="4" MinHeight="40"/>
                                                                        </ControlTemplate>
                                                                    </Thumb.Template>
                                                                </Thumb>
                                                            </Track.Thumb>
                                                        </Track>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.Resources>
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid MinHeight="64">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Icon (greyscale + dimmed when locked and no real locked icon exists) -->
                                            <Grid Grid.Column="0" Width="64" Height="64" VerticalAlignment="Center">
                                                <Border CornerRadius="6" Background="#40808080">
                                                    <Border.Clip>
                                                        <RectangleGeometry RadiusX="6" RadiusY="6" Rect="0,0,64,64"/>
                                                    </Border.Clip>
                                                    <Image Source="{Binding Icon}" Opacity="{Binding IconOpacity}" Stretch="UniformToFill"
                                                           Width="64" Height="64" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                </Border>
                                                <Border Visibility="{Binding IsLocked, Converter={StaticResource BoolToVis}}" Background="#D0000000"
                                                        CornerRadius="10" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,3,3">
                                                    <Path Fill="#FFD0D0D0" Width="10" Height="11" Stretch="Uniform"
                                                          Data="M12,17A2,2 0 0,0 14,15C14,13.89 13.1,13 12,13A2,2 0 0,0 10,15A2,2 0 0,0 12,17M18,8A2,2 0 0,1 20,10V20A2,2 0 0,1 18,22H6A2,2 0 0,1 4,20V10C4,8.89 4.9,8 6,8H7V6A5,5 0 0,1 12,1A5,5 0 0,1 17,6V8H18M12,3A3,3 0 0,0 9,6V8H15V6A3,3 0 0,0 12,3Z"/>
                                                </Border>
                                            </Grid>

                                            <!-- Name / description / rarity -->
                                            <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                                                <TextBlock FontSize="18" FontWeight="Bold" TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="White"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsUnlocked}" Value="False">
                                                                    <Setter Property="Foreground" Value="#FFB8B8B8"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                    <Run Text="{Binding Name, Mode=OneWay}"/>
                                                    <InlineUIContainer BaselineAlignment="Center">
                                                        <Border Visibility="{Binding IsHidden, Converter={StaticResource BoolToVis}}" Background="#FF3A2F55"
                                                                CornerRadius="4" Padding="6,1,6,1" Margin="8,0,0,0">
                                                            <TextBlock Text="SECRET" FontSize="10" FontWeight="Bold" Foreground="#FFC8B8FF"/>
                                                        </Border>
                                                    </InlineUIContainer>
                                                </TextBlock>
                                                <TextBlock Text="{Binding DisplayDescription}" FontSize="14" TextWrapping="Wrap"
                                                           TextTrimming="CharacterEllipsis" MaxHeight="40" Margin="0,3,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#FFD0D0D0"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsConcealed}" Value="True">
                                                                    <Setter Property="FontStyle" Value="Italic"/>
                                                                    <Setter Property="Foreground" Value="#FF8C8C8C"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding RarityText}" Foreground="{Binding RarityColor}" FontSize="12" Margin="0,4,0,0"
                                                           Visibility="{Binding HasRarity, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>

                                            <!-- Status: unlock date / locked + progress -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" MinWidth="190">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Path Fill="#FF7FC97F" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"
                                                          Visibility="{Binding IsUnlocked, Converter={StaticResource BoolToVis}}"
                                                          Data="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z"/>
                                                    <TextBlock Text="{Binding StatusText}" FontSize="14">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#FF7FC97F"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsUnlocked}" Value="False">
                                                                        <Setter Property="Foreground" Value="#FF8C8C8C"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                                <TextBlock Text="{Binding ProgressText}" FontSize="12" Foreground="#FFB0B0B0" HorizontalAlignment="Right" Margin="0,3,0,0"
                                                           Visibility="{Binding HasProgress, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="{Binding AchievementList.EmptyText}" FontSize="18" Foreground="#FF9A9A9A"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding AchievementList.IsEmpty, Converter={StaticResource BoolToVis}}"/>
                        </Grid>

                        <!-- Footer: control hints + game pause state -->
                        <Grid Grid.Row="4" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock FontSize="12" Foreground="#FF8A8A8A" TextWrapping="Wrap"
                                           Text="Controller: D-pad or stick to move (hold to repeat). Left and Right page. LT and RT jump to the ends. LB, RB, or X filters. Y reveals secrets. B goes back."/>
                                <TextBlock FontSize="12" Foreground="#FF6A6A6A" TextWrapping="Wrap" Margin="0,2,0,0"
                                           Text="Keyboard and mouse: arrow keys, Page Up and Page Down, Home and End. Left, Right, or Tab filters. H reveals secrets. Esc or Backspace goes back. Use the wheel to scroll."/>
                            </StackPanel>
                            <Border Grid.Column="1" Visibility="{Binding HasGamePauseStatus, Converter={StaticResource BoolToVis}}"
                                    Background="#FF2C2C2C" CornerRadius="6" Padding="10,4,10,4" Margin="12,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Path Fill="#FFE0B040" Width="11" Height="12" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"
                                          Data="M6,19H10V5H6V19M14,5V19H18V5H14Z"/>
                                    <TextBlock Text="{Binding GamePauseStatus}" FontSize="12" Foreground="White"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===== Audio panel layer: in-overlay Audio Switcher view, same window, shown on top of MainLayer.
                 Binds straight to the Audio Switcher plugin's theme API (AudioTheme), so it stays in sync with the plugin. ===== -->
            <Grid x:Name="AudioPanelLayer" Visibility="{Binding IsAudioPanelOpen, Converter={StaticResource BoolToVis}}"
                  KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="None">
                <Rectangle Fill="#D0000000"/>
                <Border Width="760" Height="830" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="#FF1B1B1B" CornerRadius="12" BorderBrush="#80808080" BorderThickness="1" Padding="32,24,32,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header: title + current volume and output device -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Path Fill="#FFE0B040" Height="14" Width="14" Stretch="Uniform" VerticalAlignment="Center"
                                          Data="M14,3.23V5.29C16.89,6.15 19,8.83 19,12C19,15.17 16.89,17.84 14,18.7V20.77C18,19.86 21,16.28 21,12C21,7.72 18,4.14 14,3.23M16.5,12C16.5,10.23 15.5,8.71 14,7.97V16C15.5,15.29 16.5,13.76 16.5,12M3,9V15H7L12,20V4L7,9H3Z"/>
                                    <TextBlock Text="AUDIO" FontSize="13" FontWeight="Bold" Foreground="#FF9A9A9A" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Audio Switcher" FontSize="32" FontWeight="Bold" Foreground="White"
                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0,0,0">
                                <TextBlock Text="{Binding AudioTheme.CurrentVolumeLabel}" FontSize="36" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding AudioTheme.CurrentDeviceName}" FontSize="15" Foreground="#FFD0D0D0" HorizontalAlignment="Right"
                                           MaxWidth="300" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>

                        <!-- Volume bar -->
                        <ProgressBar Grid.Row="1" Height="6" Margin="0,14,0,16" Minimum="0" Maximum="100"
                                     Value="{Binding AudioTheme.CurrentVolumePercent, Mode=OneWay}"
                                     Foreground="#FFE0B040" Background="#FF333333" BorderThickness="0"/>

                        <!-- Tabs + back -->
                        <Grid Grid.Row="2" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Border Style="{StaticResource AchHintBadge}">
                                    <TextBlock Text="LB" Style="{StaticResource AchHintText}"/>
                                </Border>
                                <Button Style="{StaticResource AchTabButton}" Content="System"
                                        Tag="{Binding IsAudioSystemTab}" Command="{Binding SetAudioTabCommand}" CommandParameter="System"/>
                                <Button Style="{StaticResource AchTabButton}" Content="Media"
                                        Tag="{Binding IsAudioMediaTab}" Command="{Binding SetAudioTabCommand}" CommandParameter="Media"/>
                                <Border Style="{StaticResource AchHintBadge}">
                                    <TextBlock Text="RB" Style="{StaticResource AchHintText}"/>
                                </Border>
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource AchActionButton}" Command="{Binding CloseAudioPanelCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource AchHintBadge}">
                                        <TextBlock Text="B" Style="{StaticResource AchHintText}"/>
                                    </Border>
                                    <TextBlock Text="Back" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Content -->
                        <ScrollViewer x:Name="AudioScroll" Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      Focusable="False" PanningMode="VerticalOnly" Padding="0,0,4,0">
                            <ScrollViewer.Resources>
                                <!-- slim dark scrollbar -->
                                <Style TargetType="ScrollBar">
                                    <Setter Property="Width" Value="8"/>
                                    <Setter Property="MinWidth" Value="8"/>
                                    <Setter Property="Margin" Value="6,0,0,0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ScrollBar">
                                                <Border Background="#20FFFFFF" CornerRadius="4">
                                                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                                                        <Track.Thumb>
                                                            <Thumb>
                                                                <Thumb.Template>
                                                                    <ControlTemplate TargetType="Thumb">
                                                                        <Border Background="#90FFFFFF" CornerRadius="4" MinHeight="40"/>
                                                                    </ControlTemplate>
                                                                </Thumb.Template>
                                                            </Thumb>
                                                        </Track.Thumb>
                                                    </Track>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ScrollViewer.Resources>
                            <Grid>
                                <!-- ===== System tab ===== -->
                                <StackPanel x:Name="AudioSystemContent" Visibility="{Binding IsAudioSystemTab, Converter={StaticResource BoolToVis}}">
                                    <!-- Windows volume -->
                                    <Border Style="{StaticResource AudioRowCard}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Path Grid.Row="0" Grid.Column="0" Width="22" Height="22" Stretch="Uniform" Fill="#FFD0D0D0" Margin="0,0,14,0" VerticalAlignment="Center"
                                                  Data="{Binding AudioTheme.CurrentOutputVolumeIconGeometry}"/>
                                            <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Windows volume" FontSize="18" FontWeight="Bold" Foreground="White"/>
                                                <TextBlock Text="The default output volume" FontSize="12" Foreground="#FF8C8C8C" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding AudioTheme.CurrentVolumeLabel}" FontSize="20" FontWeight="Bold"
                                                       Foreground="#FFE0B040" VerticalAlignment="Center"/>
                                            <Slider Grid.Row="1" Grid.ColumnSpan="3" Margin="0,10,0,0" Style="{StaticResource AudioSlider}"
                                                    Value="{Binding AudioTheme.CurrentVolumePercent, Mode=TwoWay}"/>
                                        </Grid>
                                    </Border>

                                    <!-- Game volume (only while a game is running) -->
                                    <Border Style="{StaticResource AudioRowCard}" Visibility="{Binding AudioTheme.HasRunningGame, Converter={StaticResource BoolToVis}}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Path Grid.Row="0" Grid.Column="0" Width="22" Height="22" Stretch="Uniform" Fill="#FFD0D0D0" Margin="0,0,14,0" VerticalAlignment="Center"
                                                  Data="M7,6H17A6,6 0 0,1 23,12A6,6 0 0,1 17,18C15,18 13.5,17.2 12.5,16H11.5C10.5,17.2 9,18 7,18A6,6 0 0,1 1,12A6,6 0 0,1 7,6M6,9V11H4V13H6V15H8V13H10V11H8V9H6M15.5,12A1.5,1.5 0 0,0 14,13.5A1.5,1.5 0 0,0 15.5,15A1.5,1.5 0 0,0 17,13.5A1.5,1.5 0 0,0 15.5,12M18.5,9A1.5,1.5 0 0,0 17,10.5A1.5,1.5 0 0,0 18.5,12A1.5,1.5 0 0,0 20,10.5A1.5,1.5 0 0,0 18.5,9Z"/>
                                            <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="GAME VOLUME" FontSize="11" FontWeight="Bold" Foreground="#FF8C8C8C"/>
                                                <TextBlock Text="{Binding AudioTheme.CurrentGameName}" FontSize="18" FontWeight="Bold" Foreground="White"
                                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding AudioTheme.CurrentGameVolumeLabel}" FontSize="20" FontWeight="Bold"
                                                       Foreground="#FFE0B040" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                            <Slider Grid.Row="1" Grid.ColumnSpan="3" Margin="0,10,0,0" Style="{StaticResource AudioSlider}"
                                                    IsEnabled="{Binding AudioTheme.HasActiveGameAudioSession}"
                                                    Value="{Binding AudioTheme.CurrentGameVolumePercent, Mode=TwoWay}"/>
                                        </Grid>
                                    </Border>

                                    <!-- Mute -->
                                    <Button Style="{StaticResource AudioRowButton}" Command="{Binding AudioTheme.ToggleMuteCommand}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Path Grid.Column="0" Width="22" Height="22" Stretch="Uniform" Fill="#FFD0D0D0" Margin="0,0,14,0" VerticalAlignment="Center"
                                                  Data="{Binding AudioTheme.CurrentOutputVolumeIconGeometry}"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Mute audio" FontSize="18" FontWeight="Bold" Foreground="White"/>
                                                <TextBlock Text="Toggle mute for the current output device" FontSize="12" Foreground="#FF8C8C8C" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <Border Grid.Column="2" CornerRadius="12" Padding="14,4,14,4" VerticalAlignment="Center" BorderThickness="1" BorderBrush="#60808080">
                                                <TextBlock FontSize="12" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="OFF"/>
                                                            <Setter Property="Foreground" Value="#FFB0B0B0"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding AudioTheme.IsMuted}" Value="True">
                                                                    <Setter Property="Text" Value="ON"/>
                                                                    <Setter Property="Foreground" Value="#FFE0B040"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </Button>

                                    <!-- Output devices -->
                                    <TextBlock Text="OUTPUT DEVICE" Style="{StaticResource AudioSectionCaption}"/>
                                    <ItemsControl ItemsSource="{Binding AudioTheme.Devices}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource AudioRowButton}"
                                                        Command="{Binding DataContext.AudioTheme.SetDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding Id}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Path Grid.Column="0" Width="22" Height="22" Stretch="Uniform" Fill="#FFD0D0D0" Margin="0,0,14,0" VerticalAlignment="Center"
                                                              Data="{Binding IconGeometry}"/>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding WindowsName}" FontSize="12" Foreground="#FF8C8C8C" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                                            <TextBlock Text="{Binding BatteryLabel}" FontSize="13" Foreground="#FFB0B0B0" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                            <Path Fill="#FFE0B040" Width="16" Height="16" Stretch="Uniform"
                                                                  Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}"
                                                                  Data="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- ===== Media tab ===== -->
                                <StackPanel x:Name="AudioMediaContent" Visibility="{Binding IsAudioMediaTab, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Other apps playing audio. Each one has its own volume." FontSize="13" Foreground="#FF8C8C8C" Margin="4,0,0,10"/>
                                    <ItemsControl ItemsSource="{Binding AudioTheme.MediaSessions}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource AudioRowCard}">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Path Grid.Row="0" Grid.Column="0" Width="20" Height="20" Stretch="Uniform" Fill="#FFD0D0D0" Margin="0,0,14,0" VerticalAlignment="Center"
                                                              Data="{Binding IconGeometry}"/>
                                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DisplayName}" FontSize="18" FontWeight="Bold" Foreground="White"
                                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding VolumeLabel}" FontSize="20" FontWeight="Bold" Foreground="#FFE0B040"
                                                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                                                        <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,10,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Slider Grid.Column="0" Style="{StaticResource AudioSlider}" Value="{Binding VolumePercent, Mode=TwoWay}"/>
                                                            <Button Grid.Column="1" Style="{StaticResource AudioRowButton}" Margin="16,0,0,0"
                                                                    Command="{Binding ToggleMuteCommand}">
                                                                <TextBlock FontSize="13" FontWeight="Bold" HorizontalAlignment="Center">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Text" Value="Mute"/>
                                                                            <Setter Property="Foreground" Value="White"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                                                    <Setter Property="Text" Value="Muted"/>
                                                                                    <Setter Property="Foreground" Value="#FFE0B040"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Button>
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="Nothing else is playing audio right now." FontSize="16" Foreground="#FF9A9A9A"
                                               HorizontalAlignment="Center" Margin="0,40,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding AudioTheme.HasMediaSessions}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>

                        <!-- Footer: control hints -->
                        <StackPanel Grid.Row="4" Margin="0,12,0,0">
                            <TextBlock FontSize="12" Foreground="#FF8A8A8A" TextWrapping="Wrap"
                                       Text="Controller: D-pad or stick up and down to move, left and right to change volume, A to select, LB and RB switch tabs, B goes back."/>
                            <TextBlock FontSize="12" Foreground="#FF6A6A6A" TextWrapping="Wrap" Margin="0,2,0,0"
                                       Text="Keyboard and mouse: arrow keys move and change volume, Enter selects, Left or Right on a button switches tabs, Esc or Backspace goes back. Drag the sliders with the mouse."/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- The screenshot gallery layer (Screenshots Visualizer) is added on top of everything else from code, see
                 OverlayWindow.xaml.cs. It is not declared here because the plugin class has the same name as the namespace,
                 which breaks the generated field for a named custom control. -->
        </Grid>
    </Viewbox>
</Window>