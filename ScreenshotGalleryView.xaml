<UserControl x:Class="PlayniteGameOverlay.ScreenshotGalleryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Same look as the achievement list: hint badges, action buttons, dark panel, white selection border -->
        <Style x:Key="SsvHintBadge" TargetType="Border">
            <Setter Property="Background" Value="#FF3A3A3A"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,1,6,1"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SsvHintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FFD0D0D0"/>
        </Style>

        <Style x:Key="SsvActionButton" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActBorder" Background="#FF2A2A2A" CornerRadius="8" Padding="12,7,14,7"
                                BorderBrush="#40808080" BorderThickness="1">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActBorder" Property="Background" Value="#FF3A3A3A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ActBorder" Property="Background" Value="#FF4A4A4A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Round previous/next buttons on the viewer, for mouse and touch -->
        <Style x:Key="SsvChevronButton" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ChevBorder" Width="48" Height="48" CornerRadius="24" Background="#AA1B1B1B"
                                BorderBrush="#60808080" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChevBorder" Property="Background" Value="#FF363636"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One capture card. Width: 244 content + 2*8 padding + 2*5 margin = 270, so 4 cards fill a row. -->
        <Style x:Key="SsvCardStyle" TargetType="ListBoxItem">
            <EventSetter Event="MouseLeftButtonUp" Handler="Card_MouseLeftButtonUp"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="CardBorder" Background="#FF242424" CornerRadius="10" BorderThickness="2"
                                BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="#FF2C2C2C"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="#FF363636"/>
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#C0FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Whole control follows IsOpen; the window adds it on top of the other layers -->
    <Grid Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}">

        <!-- ===== Grid layer ===== -->
        <Grid x:Name="GalleryLayer">
            <Rectangle Fill="#D0000000"/>
            <Border Width="1180" Height="830" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#FF1B1B1B" CornerRadius="12" BorderBrush="#80808080" BorderThickness="1" Padding="32,24,32,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header: game name + number of captures -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Path Fill="#FF6FA8FF" Height="14" Width="14" Stretch="Uniform" VerticalAlignment="Center"
                                      Data="M8.5,13.5L11,16.5L14.5,12L19,18H5M21,19V5C21,3.89 20.1,3 19,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19Z"/>
                                <TextBlock Text="SCREENSHOTS" FontSize="13" FontWeight="Bold" Foreground="#FF9A9A9A" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding GameName}" FontSize="32" FontWeight="Bold" Foreground="White"
                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0,0,0">
                            <TextBlock Text="{Binding HeaderCountText}" FontSize="36" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding HeaderCountCaption}" FontSize="15" Foreground="#FFD0D0D0" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>

                    <!-- Divider -->
                    <Rectangle Grid.Row="1" Height="1" Margin="0,14,0,16" Fill="#40808080"/>

                    <!-- Status text + actions -->
                    <Grid Grid.Row="2" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding ShowingText}" FontSize="13" Foreground="#FF808080"
                                   VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource SsvActionButton}" Command="{Binding RefreshCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource SsvHintBadge}">
                                        <TextBlock Text="Y" Style="{StaticResource SsvHintText}"/>
                                    </Border>
                                    <TextBlock Text="Rescan" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SsvActionButton}" Command="{Binding OpenFolderCommand}" Margin="10,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource SsvHintBadge}">
                                        <TextBlock Text="X" Style="{StaticResource SsvHintText}"/>
                                    </Border>
                                    <TextBlock Text="Open folder" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SsvActionButton}" Command="{Binding BackCommand}" Margin="10,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource SsvHintBadge}">
                                        <TextBlock Text="B" Style="{StaticResource SsvHintText}"/>
                                    </Border>
                                    <TextBlock Text="Back" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Card grid. Capped to the newest captures, so no virtualization is needed. -->
                    <Grid Grid.Row="3">
                        <ListBox x:Name="ScreenshotListBox"
                                 ItemsSource="{Binding Items}"
                                 ItemContainerStyle="{StaticResource SsvCardStyle}"
                                 Background="Transparent" BorderThickness="0" Padding="0,0,4,0"
                                 SelectionMode="Single" FocusVisualStyle="{x:Null}"
                                 KeyboardNavigation.DirectionalNavigation="None"
                                 KeyboardNavigation.TabNavigation="None"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.CanContentScroll="False"
                                 VirtualizingPanel.IsVirtualizing="False">
                            <ListBox.Resources>
                                <Style TargetType="ScrollBar">
                                    <Setter Property="Width" Value="8"/>
                                    <Setter Property="MinWidth" Value="8"/>
                                    <Setter Property="Margin" Value="6,0,0,0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ScrollBar">
                                                <Border Background="#20FFFFFF" CornerRadius="4">
                                                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                                                        <Track.Thumb>
                                                            <Thumb>
                                                                <Thumb.Template>
                                                                    <ControlTemplate TargetType="Thumb">
                                                                        <Border Background="#90FFFFFF" CornerRadius="4" MinHeight="40"/>
                                                                    </ControlTemplate>
                                                                </Thumb.Template>
                                                            </Thumb>
                                                        </Track.Thumb>
                                                    </Track>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.Resources>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Width="244">
                                        <Border Width="244" Height="138" CornerRadius="6" Background="#40808080">
                                            <Border.Clip>
                                                <RectangleGeometry RadiusX="6" RadiusY="6" Rect="0,0,244,138"/>
                                            </Border.Clip>
                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                                                   Width="244" Height="138" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>
                                        <Grid Margin="2,8,2,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding DateText}" FontSize="14" FontWeight="Bold" Foreground="White"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding FileName}" FontSize="11" Foreground="#FF8C8C8C"
                                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontSize="11" Foreground="#FFB0B0B0"
                                                       VerticalAlignment="Top" Margin="8,2,0,0"/>
                                        </Grid>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="{Binding ShowingText}" FontSize="18" Foreground="#FF9A9A9A"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding EmptyText}" FontSize="18" Foreground="#FF9A9A9A" TextWrapping="Wrap"
                                   TextAlignment="Center" MaxWidth="760"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding ShowEmptyText, Converter={StaticResource BoolToVis}}"/>
                    </Grid>

                    <!-- Footer: control hints + game pause state -->
                    <Grid Grid.Row="4" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock FontSize="12" Foreground="#FF8A8A8A" TextWrapping="Wrap"
                                       Text="Controller: D-pad or stick to move (hold to repeat). A opens a capture. LT and RT jump to the ends. Y rescans the folders. X opens the captures folder. B goes back."/>
                            <TextBlock FontSize="12" Foreground="#FF6A6A6A" TextWrapping="Wrap" Margin="0,2,0,0"
                                       Text="Keyboard and mouse: arrow keys, Page Up and Page Down, Home and End. Enter opens. R rescans. O opens the folder. Backspace or Esc goes back. Click a card to open it. Use the wheel to scroll."/>
                        </StackPanel>
                        <Border Grid.Column="1" Visibility="{Binding HasGamePauseStatus, Converter={StaticResource BoolToVis}}"
                                Background="#FF2C2C2C" CornerRadius="6" Padding="10,4,10,4" Margin="12,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Path Fill="#FFE0B040" Width="11" Height="12" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"
                                      Data="M6,19H10V5H6V19M14,5V19H18V5H14Z"/>
                                <TextBlock Text="{Binding GamePauseStatus}" FontSize="12" Foreground="White"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== Viewer layer: one capture, full size ===== -->
        <Grid x:Name="ViewerLayer" Visibility="{Binding IsViewerOpen, Converter={StaticResource BoolToVis}}">
            <Rectangle Fill="#F5000000"/>
            <Grid Margin="40,22,40,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header: game + date and source, file info chip, position -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ViewerTitle}" FontSize="30" FontWeight="Bold" Foreground="White"
                                   TextTrimming="CharacterEllipsis" MaxWidth="520"/>
                        <TextBlock Text="{Binding ViewerSubtitle}" FontSize="14" Foreground="#FFB0B0B0" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border HorizontalAlignment="Center" VerticalAlignment="Top" Background="#FF2A2A2A" CornerRadius="6"
                            Padding="14,4,14,4" BorderBrush="#40808080" BorderThickness="1">
                        <TextBlock Text="{Binding ViewerInfo}" FontSize="13" FontWeight="SemiBold" Foreground="#FFE0E0E0"/>
                    </Border>
                    <TextBlock Text="{Binding ViewerCounter}" HorizontalAlignment="Right" VerticalAlignment="Center"
                               FontSize="26" FontWeight="Bold" Foreground="White"/>
                </Grid>

                <!-- Image panel -->
                <Border Grid.Row="1" Background="#FF121212" CornerRadius="12" BorderBrush="#80808080" BorderThickness="1" Padding="6">
                    <Grid>
                        <Image Source="{Binding ViewerImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <Button Style="{StaticResource SsvChevronButton}" Command="{Binding ViewerPreviousCommand}"
                                HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0">
                            <Path Fill="White" Width="20" Height="20" Stretch="Uniform"
                                  Data="M15.41,16.58L10.83,12L15.41,7.41L14,6L8,12L14,18L15.41,16.58Z"/>
                        </Button>
                        <Button Style="{StaticResource SsvChevronButton}" Command="{Binding ViewerNextCommand}"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                            <Path Fill="White" Width="20" Height="20" Stretch="Uniform"
                                  Data="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Footer pill -->
                <Border Grid.Row="2" Margin="0,16,0,0" HorizontalAlignment="Center" Background="#FF242424" CornerRadius="10"
                        BorderBrush="#80808080" BorderThickness="1" Padding="14,6,14,6">
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource SsvHintBadge}">
                            <TextBlock Text="&#x2190; / &#x2192;" Style="{StaticResource SsvHintText}"/>
                        </Border>
                        <TextBlock Text="Browse" FontSize="14" Foreground="#FFD0D0D0" VerticalAlignment="Center" Margin="0,0,18,0"/>
                        <Button Style="{StaticResource SsvActionButton}" Command="{Binding BackCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource SsvHintBadge}">
                                    <TextBlock Text="B" Style="{StaticResource SsvHintText}"/>
                                </Border>
                                <TextBlock Text="Back" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
